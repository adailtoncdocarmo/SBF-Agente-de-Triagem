# ============================================================
# Configuração — copie este arquivo para `.env` e preencha a chave.
# A chave da Anthropic é o ÚNICO ajuste necessário para triar.
#   cp .env.example .env
# ============================================================

# Chave da API da Anthropic (Claude). Necessária para a triagem (Agente Régua e
# estágios de julgamento). O esqueleto e os testes determinísticos rodam sem ela.
ANTHROPIC_API_KEY=

# (Opcional) Modelos por estágio — defaults sãos já no código (config.py).
# Trade-off custo×qualidade: Haiku nos estágios simples, Sonnet onde a decisão mora.
# MODELO_REGUA=claude-sonnet-4-6
# MODELO_PORTAO1=claude-haiku-4-5
# MODELO_SCORING=claude-sonnet-4-6
# MODELO_FLAGS=claude-haiku-4-5
# MODELO_COMPARACAO=claude-sonnet-4-6

# (Opcional) Processamento
# CONCORRENCIA_CVS=4
# USAR_BATCH_API=false
